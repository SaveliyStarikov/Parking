@page
@model Parking.Pages.ParkingSpacesModel
@{
    ViewData["Title"] = "Добавить парковочное место";
}

<h2>Добавить парковочное место</h2>

<form method="post">
    <div class="form-group">
        <label>Автомобиль</label>
        <select asp-for="SelectedCarId" class="form-control">
            <option value="">-- Выберите авто --</option>
            @foreach (var car in Model.Cars)
            {
                <option value="@car.Id">@car.LicensePlate - @car.Brand @car.Model</option>
            }
        </select>
        <span asp-validation-for="SelectedCarId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Дата начала</label>
        <input name="NewPlace.StartDate" type="datetime-local" class="form-control"
               value="@(Model.NewPlace.StartDate.HasValue ? Model.NewPlace.StartDate.Value.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" required />
        <span asp-validation-for="NewPlace.StartDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Дата окончания</label>
        <input name="NewPlace.EndDate" type="datetime-local" class="form-control"
               value="@(Model.NewPlace.EndDate.HasValue ? Model.NewPlace.EndDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")" required />
        <span asp-validation-for="NewPlace.EndDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Сохранить</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
