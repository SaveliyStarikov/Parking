@page
@model Parking.Pages.ParkingSpacesModel
@{
    ViewData["Title"] = "Добавить парковочное место";
}

<h2>Добавить парковочное место</h2>

<form method="post">
    <div class="form-group">
        <label>Автомобиль</label>
        <select asp-for="SelectedCarId" class="form-control" required>
            <option value="">-- Выберите авто --</option>
            @foreach (var car in Model.Cars)
            {
                <option value="@car.Id">@car.LicensePlate - @car.Brand @car.Model</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Дата начала</label>
        <input asp-for="NewPlace.StartDate" type="datetime-local" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Дата окончания</label>
        <input asp-for="NewPlace.EndDate" type="datetime-local" class="form-control"
               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
        <span asp-validation-for="NewPlace.EndDate" class="text-danger"></span>
        <span id="dateValidationError" class="text-danger" style="display:none;">Дата начала не может быть позже даты окончания</span>
    </div>

    <button type="submit" class="btn btn-success">Сохранить</button>
</form>

@section Scripts {
    <script>
        function validateDates() {
            const startDate = new Date(document.querySelector('#NewPlace_StartDate').value);
            const endDate = new Date(document.querySelector('#NewPlace_EndDate').value);
            const errorElement = document.querySelector('#dateValidationError');

            if (startDate > endDate) {
                errorElement.style.display = 'block';
                return false;
            }
            errorElement.style.display = 'none';
            return true;
        }

        document.querySelector('form').addEventListener('submit', function(e) {
            if (!validateDates()) {
                e.preventDefault();
            }
        });

        document.querySelector('#NewPlace_StartDate').addEventListener('change', validateDates);
        document.querySelector('#NewPlace_EndDate').addEventListener('change', validateDates);
    </script>
}