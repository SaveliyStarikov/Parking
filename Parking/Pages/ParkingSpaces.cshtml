@page
@model Parking.Pages.ParkingSpacesModel
@{
    ViewData["Title"] = "Парковочные места";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="~/css/parking.css" />
<h1 class="page-title"><i class="fas fa-parking"></i> Парковочные места</h1>

<form method="post" asp-page-handler="AddPlace" class="add-place-form">
    <button type="submit" class="btn btn-primary btn-lg shadow">+ Добавить новое место</button>
</form>

<div class="grid-container">
    @foreach (var place in Model.Places)
    {
        var ownerName = Model.GetOwnerByCarInfo(place.Car)?.Name ?? "—";
        var carInfo = !string.IsNullOrEmpty(place.Car) ? place.Car : "—";
        var tileClass = place.Status == "Свободно" ? "tile-free" : "tile-occupied";

        <div class="tile @tileClass shadow-sm">
            <h5 class="tile-title">@place.Name</h5>

            <p><span class="badge @(place.Status == "Свободно" ? "bg-success" : "bg-danger")">@place.Status</span></p>

            <p>🚗 <strong>Машина:</strong> @carInfo</p>
            <p>👤 <strong>Владелец:</strong> @ownerName</p>

            <p>
                📅 <strong>Даты:</strong>
                @if (place.StartDate.HasValue && place.EndDate.HasValue)
                {
                    @($"{place.StartDate.Value:g} - {place.EndDate.Value:g}")
                }
                else
                {
                    <text>—</text>
                }
            </p>

            @if (place.Status == "Свободно")
            {
                <form method="post" asp-page-handler="OccupyPlace" class="form-inline">
                    <input type="hidden" name="SelectedPlaceId" value="@place.Id" />
                    <div class="form-group mb-2">
                        <select asp-for="SelectedCarId" class="form-control" required>
                            <option value="">-- Машина --</option>
                            @foreach (var car in Model.Cars)
                            {
                                <option value="@car.Id">@car.LicensePlate - @car.Brand @car.Model</option>
                            }
                        </select>
                        <span asp-validation-for="SelectedCarId" class="text-danger small"></span> 
                    </div>

                    <div class="form-group mb-2">
                        <input asp-for="StartDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="StartDate" class="text-danger small"></span> 
                    </div>

                    <div class="form-group mb-2">
                        <input asp-for="EndDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">🚗 Занять место</button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="FreePlace" class="form-inline">
                    <input type="hidden" name="id" value="@place.Id" />
                    <button type="submit" class="btn btn-warning w-100">🛑 Освободить место</button>
                </form>
            }

            <form method="post" asp-page-handler="DeletePlace" class="form-inline" onsubmit="return confirm('Вы уверены, что хотите удалить это место?');">
                <input type="hidden" name="id" value="@place.Id" />
                <button type="submit" class="btn btn-danger w-100 mt-2">🗑 Удалить место</button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tiles = document.querySelectorAll('.tile');
        tiles.forEach((tile, index) => {
            setTimeout(() => tile.classList.add('show'), index * 150);
        });
    });
</script>
