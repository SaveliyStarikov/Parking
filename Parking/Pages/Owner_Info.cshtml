@page
@model Parking.Pages.Owner_InfoModel

@{
    ViewData["Title"] = "Список владельцев";
}

<h1>Список владельцев автомобилей</h1>

<!-- Форма для добавления нового владельца -->
<form method="post">
    <input type="text" asp-for="NewOwner.Name" placeholder="Имя владельца" required />
    <input type="email" asp-for="NewOwner.Email" placeholder="Email" />
    <input type="text" asp-for="NewOwner.Phone" placeholder="Телефон" />
    <input type="text" asp-for="NewOwner.Car.LicensePlate" placeholder="Госномер" required />
    <input type="text" asp-for="NewOwner.Car.Brand" placeholder="Марка" required />
    <input type="text" asp-for="NewOwner.Car.Model" placeholder="Модель" required />
    <button type="submit" asp-page-handler="Add" class="btn btn-success">Добавить</button>
</form>

<!-- Таблица владельцев -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Автомобиль</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var owner in Model.Owners)
        {
            <tr>
                <td>@owner.Name</td>
                <td>@owner.Email</td>
                <td>@owner.Phone</td>
                <td>@owner.Car.Brand @owner.Car.Model (@owner.Car.LicensePlate)</td>
                <td>
                    <form method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@owner.Id" />
                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>