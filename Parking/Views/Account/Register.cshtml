@{
    ViewData["Title"] = "Register";
}
<h2>Регистрация</h2>

<form method="post">
    <label>Имя пользователя</label><br />
    <input name="username" required /><br />
    <label>Пароль</label><br />
    <input name="password" type="password" required /><br /><br />
    <button type="submit">Зарегистрироваться</button>
</form>